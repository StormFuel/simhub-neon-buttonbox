              "Formula": {
                "JSExt": 3,
                "Interpreter": 1,
                "Expression": "var names={AssettoCorsa:'ASSETTO CORSA',AssettoCorsaCompetizione:'ACC',IRacing:'IRACING',LMU:'LE MANS ULTIMATE',RFactor2:'RFACTOR 2',Automobilista2:'AUTOMOBILISTA 2',RRRE:'RACEROOM',F12024:'F1 24',F12025:'F1 25',FH4:'FORZA HORIZON 4',FH5:'FORZA HORIZON 5',FM8:'FORZA MOTORSPORT',BeamNgDrive:'BEAMNG.DRIVE'};var code=$prop('DataCorePlugin.CurrentGame');var track=$prop('DataCorePlugin.GameData.NewData.TrackName')||'';return ((names[code]||code||'NO GAME') + (track ? '  ·  ' + track : '')).toUpperCase();"
              },
              "Mode": 2
            }
          }
        },
